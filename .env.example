# Website Zanclus: nilai publik, boleh tampil di browser.
NEXT_PUBLIC_WHATSAPP_NUMBER=6285190849237
NEXT_PUBLIC_SITE_URL=https://zanclusdive.com

# Database: isi dari hPanel, termasuk prefix nama database dan user.
# Jangan menambahkan NEXT_PUBLIC_ pada variabel database/admin.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Login CMS: tentukan email dan password admin sendiri.
ADMIN_EMAIL=
# Password unik minimal 12 karakter, disarankan 16+.
ADMIN_PASSWORD=
# String acak minimal 32 karakter; buat lewat password manager.
SESSION_SECRET=

# Aktifkan hanya jika penyedia database mensyaratkan TLS terverifikasi.
# MYSQL_SSL=true
# Jika Hostinger memberikan path Unix socket secara khusus, isi path tersebut:
# MYSQL_SOCKET=

# PORT disediakan Hostinger; tidak perlu diisi manual.
# Simpan file berisi kredensial secara pribadi, jangan upload ke GitHub.
