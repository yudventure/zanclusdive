MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
ADMIN_EMAIL=
# Minimum 12 characters; use a strong unique password.
ADMIN_PASSWORD=
# Minimum 32 characters; generate a random secret, never commit it.
SESSION_SECRET=
